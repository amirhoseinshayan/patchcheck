{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchcheck:PatchRelation",
  "$ref": "#/$defs/PatchRelation",
  "$defs": {
    "PatchRelation": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "finding_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,159}$"
        },
        "hunk_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "paired_run_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relation": {
          "enum": [
            "confirmed",
            "candidate",
            "unknown",
            "rejected"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitation": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "finding_id",
        "hunk_ids",
        "locations",
        "paired_run_ids",
        "relation",
        "evidence",
        "limitation"
      ],
      "additionalProperties": false
    }
  }
}
